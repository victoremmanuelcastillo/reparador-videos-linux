{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reparador de Videos",
  "version": "0.1.0",
  "identifier": "com.viccast.reparador-videos",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run build:css",
    "beforeBuildCommand": "npm run build:css"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Reparador de Videos Corruptos",
        "width": 520,
        "height": 700,
        "minWidth": 460,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
